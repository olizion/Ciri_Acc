# ===========================================
# CIRI BACKEND CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values

# App
APP_NAME=Ciri
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Database
DATABASE_URL=postgresql+asyncpg://ciri:ciri@localhost:5432/ciri

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama (Local LLM for OCR)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# ===========================================
# MASKINPORTEN CONFIGURATION
# ===========================================
# Get credentials from: https://samarbeid.digdir.no
# See MASKINPORTEN_SETUP.md for detailed instructions


# TODO Fiks dette
# Environment: "test" for testing, "prod" for production
MASKINPORTEN_ENV=test

# Your Client ID from Samarbeidsportalen
# Created when you set up an "integrasjon"
MASKINPORTEN_CLIENT_ID=

# Your organization number (9 digits, no spaces)
MASKINPORTEN_ISSUER=

# Path to your virksomhetssertifikat private key (PEM format)
MASKINPORTEN_PRIVATE_KEY_PATH=./certs/private_key.pem

# OR provide the private key as base64 encoded string
# (useful for containerized deployments)
# MASKINPORTEN_PRIVATE_KEY_BASE64=

# ===========================================
# SKATTEETATEN CONFIGURATION
# ===========================================

# Scopes to request from Maskinporten
SKATTEETATEN_SCOPES=skatteetaten:skattekort

# ===========================================
# FOLKEREGISTERET (Optional)
# ===========================================
# Requires special approval from Skatteetaten
# Most apps won't have access to this

FOLKEREGISTER_ENABLED=false
FOLKEREGISTER_SCOPES=folkeregister:deling/offentligmedhjemmel

# ===========================================
# STORAGE
# ===========================================

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ===========================================
# ENCRYPTION
# ===========================================
# Used for encrypting sensitive data (personnummer, bank accounts)
# Generate with: openssl rand -base64 32

ENCRYPTION_KEY=change-me-32-byte-key-for-aes256

# ===========================================
# EMAIL MONITORING CONFIGURATION
# ===========================================
# Ciri monitors incoming emails for invoices/receipts

# Provider: "postmark" (recommended), "sendgrid", or "imap"
EMAIL_PROVIDER=postmark

# Inbound email address that receives invoices
# Example: bilag@inbound.yourcompany.com
EMAIL_INBOUND_ADDRESS=

# Your company name (for matching invoices)
COMPANY_NAME=

# Postmark settings (if using Postmark)
# Get from: https://postmarkapp.com
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_TOKEN=

# SendGrid settings (if using SendGrid)
# Get from: https://sendgrid.com
SENDGRID_API_KEY=
